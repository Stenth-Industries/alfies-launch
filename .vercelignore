# Keeps build-irrelevant bulk out of the deployment source.
#
# Patterns are gitignore syntax, so every one is anchored with a leading slash.
# Unanchored, a bare name matches a directory at ANY depth: `products` also
# matched src/app/(site)/products, which silently dropped the route from the
# build and served a 404 for /products.

/node_modules
/.next
/.claude
/.agents
/skills-lock.json
*.tsbuildinfo
/.next-dev.stderr.log
/.next-dev.stdout.log

# Render/review output and source image libraries. Nothing under src/ reads
# these; the artwork the site actually serves lives in public/.
/artifacts
/product-cover-images
/products
/brand-logo

# Scratch files kept at the repo root.
/hero.html
/temp.html
/image.png
/new-hero.png
/logo-emblem.png
/logo.png
/theme.png
/reference-design-for-home-page.png
/new-logo(with bg).jpeg
/Alfies-Compliance-Brief.pdf
